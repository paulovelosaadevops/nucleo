# ============================================================
# Núcleo — exemplo de configuração de produção
# Nunca coloque credenciais reais neste arquivo.
# Copie para .env.production e preencha somente no servidor.
# ============================================================

# Domínio
APP_DOMAIN=nucleo.seudominio.com

# PostgreSQL
POSTGRES_DB=nucleo
POSTGRES_USER=nucleo_app
POSTGRES_PASSWORD=CHANGE_WITH_A_STRONG_DATABASE_PASSWORD

# Backend database
DB_URL=jdbc:postgresql://postgres:5432/nucleo
DB_USERNAME=nucleo_app
DB_PASSWORD=CHANGE_WITH_THE_SAME_DATABASE_PASSWORD
DB_CONNECTION_TIMEOUT=10000
DB_VALIDATION_TIMEOUT=5000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_MAX_LIFETIME=1800000
DB_IDLE_TIMEOUT=600000

# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8090
MANAGEMENT_PORT=8091

# JWT
JWT_ISSUER=nucleo-api-production
JWT_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_64_BYTES
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Application
APP_WEB_URL=https://nucleo.seudominio.com
CORS_ALLOWED_ORIGINS=https://nucleo-five-eta.vercel.app
INVITATION_TTL=7d

# Frontend
NEXT_PUBLIC_API_URL=https://nucleo.seudominio.com
WEB_PORT=3000
